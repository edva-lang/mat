// mat/src/vec3.dva — 3D vector primitives and operations

#pragma float f32

#public
   #type Vec3 #packed (
      x: f32,
      y: f32,
      z: f32
   )

   vec3: Float, Float, Float => Vec3
   vec3 = x, y, z => Vec3(f32(x), f32(y), f32(z))

   zero: () => Vec3
   zero = !=> Vec3(0.0, 0.0, 0.0)

   up: () => Vec3
   up = !=> Vec3(0.0, 1.0, 0.0)

   right: () => Vec3
   right = !=> Vec3(1.0, 0.0, 0.0)

   forward: () => Vec3
   forward = !=> Vec3(0.0, 0.0, -1.0)

   add: Vec3, Vec3 => Vec3
   add = a, b => Vec3(a.x + b.x, a.y + b.y, a.z + b.z)

   sub: Vec3, Vec3 => Vec3
   sub = a, b => Vec3(a.x - b.x, a.y - b.y, a.z - b.z)

   mul: Vec3, Vec3 => Vec3
   mul = a, b => Vec3(a.x * b.x, a.y * b.y, a.z * b.z)

   scale: Vec3, Float => Vec3
   scale = v, s =>
      sf = f32(s)
      Vec3(v.x * sf, v.y * sf, v.z * sf)

   cross: Vec3, Vec3 => Vec3
   cross = a, b => Vec3(
      a.y * b.z - a.z * b.y,
      a.z * b.x - a.x * b.z,
      a.x * b.y - a.y * b.x
   )

   #pragma float default

   dot: Vec3, Vec3 => Float
   dot = a, b => Float(a.x * b.x + a.y * b.y + a.z * b.z)

   len_sq: Vec3 => Float
   len_sq = v => Float(v.x * v.x + v.y * v.y + v.z * v.z)

   len: Vec3 => Float
   len = v => %sqrt(Float(v.x * v.x + v.y * v.y + v.z * v.z))

   normalize: Vec3 => Vec3
   normalize = v =>
      l = len(v)
      l == 0.0 | zero! | scale(v, 1.0 / l)

   distance: Vec3, Vec3 => Float
   distance = a, b => len(sub(a, b))

   #pragma float f32

   lerp: Vec3, Vec3, Float => Vec3
   lerp = a, b, t =>
      tf = f32(t)
      inv_tf = 1.0 - tf
      Vec3(
         a.x * inv_tf + b.x * tf,
         a.y * inv_tf + b.y * tf,
         a.z * inv_tf + b.z * tf
      )

   negate: Vec3 => Vec3
   negate = v => Vec3(-v.x, -v.y, -v.z)
