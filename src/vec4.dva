// mat/src/vec4.dva — 4D vector primitives and operations

#pragma float f32

#use "vec3"

#public
   #type Vec4 #packed (
      x: f32,
      y: f32,
      z: f32,
      w: f32
   )

   vec4: Float, Float, Float, Float => Vec4
   vec4 = x, y, z, w => Vec4(f32(x), f32(y), f32(z), f32(w))

   from_vec3: vec3::Vec3, Float => Vec4
   from_vec3 = v, w => Vec4(v.x, v.y, v.z, f32(w))

   zero: () => Vec4
   zero = !=> Vec4(0.0, 0.0, 0.0, 0.0)

   add: Vec4, Vec4 => Vec4
   add = a, b => Vec4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w)

   sub: Vec4, Vec4 => Vec4
   sub = a, b => Vec4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w)

   scale: Vec4, Float => Vec4
   scale = v, s =>
      sf = f32(s)
      Vec4(v.x * sf, v.y * sf, v.z * sf, v.w * sf)

   #pragma float default

   dot: Vec4, Vec4 => Float
   dot = a, b => Float(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)

   len_sq: Vec4 => Float
   len_sq = v => Float(v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w)

   len: Vec4 => Float
   len = v => %sqrt(Float(v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w))

   normalize: Vec4 => Vec4
   normalize = v =>
      l = len(v)
      l == 0.0 | zero! | scale(v, 1.0 / l)

   #pragma float f32

   negate: Vec4 => Vec4
   negate = v => Vec4(-v.x, -v.y, -v.z, -v.w)
