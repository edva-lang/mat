// mat/tests/test_quat.dva — Quaternion tests
#use test
#use "../src/quat"

test_quat: () => ()
test_quat = !=>
   test::suite("mat::quat")
   q = quat::identity!
   test::check(Float(q.w) == 1.0 && Float(q.x) == 0.0, "quat identity")

   // 90 deg rotation around Y
   qy = quat::from_axis_angle(0.0, 1.0, 0.0, 1.5707963)
   l = quat::len(qy)
   test::approx_eps(l, 1.0, 0.001, "quat len")

   // Convert to Mat4
   m = quat::to_mat4(qy)
   test::eq(Float(m(15)), 1.0, "quat to mat4")

test_quat!
test::finish!
