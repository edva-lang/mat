// mat/src/quat.dva — Quaternion rotation primitives and operations
// Used for gimbal-lock-free 3D rotations, slerp interpolation, and conversion to Mat4.

#use "mat4"

#type Mat4 mat4::Mat4

#public
   #type Quat #packed (
      x: f32,
      y: f32,
      z: f32,
      w: f32
   )

   quat: Float, Float, Float, Float => Quat
   quat = x, y, z, w => Quat(f32(x), f32(y), f32(z), f32(w))

   identity: () => Quat
   identity = !=> Quat(0.0f32, 0.0f32, 0.0f32, 1.0f32)

   from_axis_angle: Float, Float, Float, Float => Quat
   from_axis_angle = ax, ay, az, angle_rad =>
      half = angle_rad * 0.5
      s = %sin(half)
      c = %cos(half)
      l = %sqrt(ax * ax + ay * ay + az * az)
      inv_l = (l == 0.0 | 1.0 | 1.0 / l) * s
      Quat(
         f32(ax * inv_l),
         f32(ay * inv_l),
         f32(az * inv_l),
         f32(c)
      )

   from_euler: Float, Float, Float => Quat
   from_euler = pitch, yaw, roll =>
      hp = pitch * 0.5
      hy = yaw * 0.5
      hr = roll * 0.5
      cp = %cos(hp)
      sp = %sin(hp)
      cy = %cos(hy)
      sy = %sin(hy)
      cr = %cos(hr)
      sr = %sin(hr)
      Quat(
         f32(sp * cy * cr - cp * sy * sr),
         f32(cp * sy * cr + sp * cy * sr),
         f32(cp * cy * sr - sp * sy * cr),
         f32(cp * cy * cr + sp * sy * sr)
      )

   // Multiply two quaternions: q = a * b
   mul: Quat, Quat => Quat
   mul = a, b =>
      Quat(
         a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
         a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
         a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
         a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
      )

   len: Quat => Float
   len = q => %sqrt(Float(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w))

   normalize: Quat => Quat
   normalize = q =>
      l = len(q)
      l == 0.0
         | identity!
         |
            inv_l = f32(1.0 / l)
            Quat(q.x * inv_l, q.y * inv_l, q.z * inv_l, q.w * inv_l)

   conjugate: Quat => Quat
   conjugate = q => Quat(-q.x, -q.y, -q.z, q.w)

   // Spherical linear interpolation between two quaternions
   slerp: Quat, Quat, Float => Quat
   slerp = a, b, t =>
      cos_half_theta = Float(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
      cos_ht = cos_half_theta < 0.0 | -cos_half_theta | cos_half_theta
      b_sign = cos_half_theta < 0.0 | -1.0f32 | 1.0f32
      sx = b.x * b_sign
      sy = b.y * b_sign
      sz = b.z * b_sign
      sw = b.w * b_sign

      cos_ht > 0.9995
         |
            tf = f32(t)
            inv_tf = 1.0f32 - tf
            normalize(Quat(
               a.x * inv_tf + sx * tf,
               a.y * inv_tf + sy * tf,
               a.z * inv_tf + sz * tf,
               a.w * inv_tf + sw * tf
            ))
         |
            sin_ht = %sqrt(1.0 - cos_ht * cos_ht)
            ratio_a = f32(%sin((1.0 - t) * 1.5707963) / sin_ht)
            ratio_b = f32(%sin(t * 1.5707963) / sin_ht)
            Quat(
               a.x * ratio_a + sx * ratio_b,
               a.y * ratio_a + sy * ratio_b,
               a.z * ratio_a + sz * ratio_b,
               a.w * ratio_a + sw * ratio_b
            )

   // Convert quaternion rotation to a 4x4 matrix
   to_mat4: Quat => Mat4
   to_mat4 = q =>
      x2 = q.x + q.x
      y2 = q.y + q.y
      z2 = q.z + q.z
      xx = q.x * x2
      xy = q.x * y2
      xz = q.x * z2
      yy = q.y * y2
      yz = q.y * z2
      zz = q.z * z2
      wx = q.w * x2
      wy = q.w * y2
      wz = q.w * z2
      mat4::mat4(
         1.0f32 - (yy + zz), xy + wz, xz - wy, 0.0f32,
         xy - wz, 1.0f32 - (xx + zz), yz + wx, 0.0f32,
         xz + wy, yz - wx, 1.0f32 - (xx + yy), 0.0f32,
         0.0f32, 0.0f32, 0.0f32, 1.0f32)
