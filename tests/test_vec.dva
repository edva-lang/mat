// mat/tests/test_vec.dva — Vector tests
#use test
#use "../src/vec2"
#use "../src/vec3"
#use "../src/vec4"

test_vec2: () => ()
test_vec2 = !=>
   test::suite("mat::vec2")
   a = vec2::vec2(1.0, 2.0)
   b = vec2::vec2(3.0, 4.0)
   c = vec2::add(a, b)
   test::eq(Float(c.x), 4.0, "vec2 add x")
   test::eq(Float(c.y), 6.0, "vec2 add y")

   d = vec2::dot(a, b) // 1*3 + 2*4 = 11
   test::eq(d, 11.0, "vec2 dot")

   l = vec2::len(vec2::vec2(3.0, 4.0))
   test::eq(l, 5.0, "vec2 len")

test_vec3: () => ()
test_vec3 = !=>
   test::suite("mat::vec3")
   a = vec3::vec3(1.0, 0.0, 0.0)
   b = vec3::vec3(0.0, 1.0, 0.0)
   c = vec3::cross(a, b)
   test::eq(Float(c.x), 0.0, "vec3 cross x")
   test::eq(Float(c.y), 0.0, "vec3 cross y")
   test::eq(Float(c.z), 1.0, "vec3 cross z")

   l = vec3::len(vec3::vec3(0.0, 3.0, 4.0))
   test::eq(l, 5.0, "vec3 len")

   n = vec3::normalize(vec3::vec3(0.0, 5.0, 0.0))
   test::eq(Float(n.y), 1.0, "vec3 normalize")

test_vec4: () => ()
test_vec4 = !=>
   test::suite("mat::vec4")
   a = vec4::vec4(1.0, 2.0, 3.0, 4.0)
   b = vec4::vec4(1.0, 1.0, 1.0, 1.0)
   c = vec4::add(a, b)
   test::eq(Float(c.x), 2.0, "vec4 add x")
   test::eq(Float(c.w), 5.0, "vec4 add w")

test_vec2!
test_vec3!
test_vec4!
test::finish!
