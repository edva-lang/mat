// mat/tests/test_vec.dva — Vector tests
#use io
#use sys
#use "../src/vec2"
#use "../src/vec3"
#use "../src/vec4"

assert: <>, String => ()
assert = ok, msg =>
   ok | --|
   io::out("FAIL: " + msg)
   sys::exit(1)

test_vec2: () => ()
test_vec2 = !=>
   a = vec2::vec2(1.0, 2.0)
   b = vec2::vec2(3.0, 4.0)
   c = vec2::add(a, b)
   assert(Float(c.x) == 4.0 && Float(c.y) == 6.0, "vec2 add")

   d = vec2::dot(a, b) // 1*3 + 2*4 = 11
   assert(d == 11.0, "vec2 dot")

   l = vec2::len(vec2::vec2(3.0, 4.0))
   assert(l == 5.0, "vec2 len")

test_vec3: () => ()
test_vec3 = !=>
   a = vec3::vec3(1.0, 0.0, 0.0)
   b = vec3::vec3(0.0, 1.0, 0.0)
   c = vec3::cross(a, b)
   assert(Float(c.x) == 0.0 && Float(c.y) == 0.0 && Float(c.z) == 1.0, "vec3 cross")

   l = vec3::len(vec3::vec3(0.0, 3.0, 4.0))
   assert(l == 5.0, "vec3 len")

   n = vec3::normalize(vec3::vec3(0.0, 5.0, 0.0))
   assert(Float(n.y) == 1.0, "vec3 normalize")

test_vec4: () => ()
test_vec4 = !=>
   a = vec4::vec4(1.0, 2.0, 3.0, 4.0)
   b = vec4::vec4(1.0, 1.0, 1.0, 1.0)
   c = vec4::add(a, b)
   assert(Float(c.x) == 2.0 && Float(c.w) == 5.0, "vec4 add")

test_vec2!
test_vec3!
test_vec4!
io::out("PASS: Vector tests")
